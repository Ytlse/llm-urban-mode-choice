    {
     "refId": "A",
     "expr": "rate(otp_requests_ok_total[1m])",
     "legendFormat": "OK"
    },
    {
     "refId": "B",
     "expr": "sum by (reason) (rate(otp_requests_err_total[1m]))",
     "legendFormat": "err {{reason}}"
