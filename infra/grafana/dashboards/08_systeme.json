  },
  {
   "type": "text",
   "title": "Périmètre des mesures",
   "options": {
    "mode": "markdown",
    "content": "⚠️ **Sous Docker Desktop (macOS), node_exporter et cAdvisor mesurent la VM Linux de Docker**, pas le Mac hôte. Le total « machine » = ressources allouées à Docker Desktop."
   },
   "id": 2,
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 0,
    "y": 1
   }
  },
  {
   "type": "gauge",
   "title": "CPU (%)",
   "datasource": {
    "type": "prometheus",
    "uid": "ffj2fwnh387pce"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 70
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     }
    }
   },
   "options": {
    "showThresholdMarkers": true
   },
   "id": 3,
   "gridPos": {
    "h": 5,
    "w": 5,
    "x": 6,
    "y": 1
   }
  },
  {
   "type": "gauge",
   "title": "RAM (%)",
   "datasource": {
    "type": "prometheus",
    "uid": "ffj2fwnh387pce"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
