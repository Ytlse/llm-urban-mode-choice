{
 "title": "06 · Cache LLM",
 "uid": "cache-llm",
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "timezone": "browser",
 "schemaVersion": 38,
 "version": 1,
 "editable": true,
 "tags": [
  "sim",
  "llm"
 ],
 "links": [
  {
   "title": "Dashboards simulation",
   "type": "dashboards",
   "tags": [
    "sim"
   ],
   "asDropdown": true,
   "includeVars": false,
   "keepTime": true,
   "icon": "dashboard"
  }
 ],
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Efficacité",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   }
  },
  {
   "type": "stat",
   "title": "Appels LLM évités (hits)",
   "datasource": {
    "type": "prometheus",
    "uid": "ffj2fwnh387pce"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(llm_cache_hits_total)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    }
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "id": 2,
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 0,
    "y": 1
   }
  },
  {
   "type": "stat",
   "title": "Misses",
   "datasource": {
    "type": "prometheus",
    "uid": "ffj2fwnh387pce"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(llm_cache_misses_total)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    }
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "id": 3,
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 6,
    "y": 1
   }
  },
  {
   "type": "gauge",
   "title": "Taux de hit (%)",
   "datasource": {
    "type": "prometheus",
    "uid": "ffj2fwnh387pce"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * sum(llm_cache_hits_total) / clamp_min(sum(llm_cache_hits_total) + sum(llm_cache_misses_total), 1)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 30
       },
       {
        "color": "green",
        "value": 60
       }
      ]
     }
    }
   },
   "options": {
    "showThresholdMarkers": true
   },
   "id": 4,
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 12,
    "y": 1
   }
  },
  {
   "type": "stat",
   "title": "Tokens économisés (est.)",
   "datasource": {
    "type": "prometheus",
    "uid": "ffj2fwnh387pce"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(llm_cache_hits_total) * ((llm_tokens_in_total{provider=\"__all__\"} + llm_tokens_out_total{provider=\"__all__\"}) / clamp_min(sum(llm_provider_calls_ok_total), 1))"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "unit": "short"
    }
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "description": "Hits × tokens moyens par appel LLM réussi. Estimation.",
   "id": 5,
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 18,
    "y": 1
   }
  },
  {
   "id": 6,
   "type": "row",
   "title": "Débits",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 6
   }
  },
  {
   "type": "timeseries",
   "title": "Hits vs misses (req/min)",
   "datasource": {
    "type": "prometheus",
    "uid": "ffj2fwnh387pce"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(llm_cache_hits_total[1m])) * 60",
     "legendFormat": "hits"
    },
    {
     "refId": "B",
     "expr": "sum by (reason) (rate(llm_cache_misses_total[1m])) * 60",
     "legendFormat": "miss {{reason}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     },
     "color": {
      "mode": "palette-classic"
     }
    }
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 7,
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 7
   }
  },
  {
   "type": "timeseries",
   "title": "Hits par motif d'activité (req/min)",
   "datasource": {
    "type": "prometheus",
    "uid": "ffj2fwnh387pce"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (activity_purpose) (rate(llm_cache_hits_total[1m])) * 60",
     "legendFormat": "{{activity_purpose}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     },
     "color": {
      "mode": "palette-classic"
     }
    }
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "description": "Quelles catégories d'activités profitent le plus du cache.",
   "id": 8,
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 7
   }
  },
  {
   "id": 9,
   "type": "row",
   "title": "Qualité & latence",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 15
   }
  },
  {
   "type": "bargauge",
   "title": "Misses par raison (cumul)",
   "datasource": {
    "type": "prometheus",
    "uid": "ffj2fwnh387pce"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (reason) (llm_cache_misses_total)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    }
   },
   "options": {
    "displayMode": "gradient",
    "orientation": "horizontal",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "description": "no_result, below_threshold… below_threshold élevé = seuil de similarité trop strict ?",
   "id": 10,
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 16
   }
  },
  {
   "type": "timeseries",
   "title": "Latence lookup p95 (s)",
   "datasource": {
    "type": "prometheus",
    "uid": "ffj2fwnh387pce"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, rate(llm_cache_lookup_seconds_bucket[5m]))",
     "legendFormat": "lookup p95"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     },
     "color": {
      "mode": "palette-classic"
     },
     "unit": "s"
    }
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "description": "Embed + recherche Qdrant. Détail embed/insert : /debug-run.",
   "id": 11,
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 16
   }
