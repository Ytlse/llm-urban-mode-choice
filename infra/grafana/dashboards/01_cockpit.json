  {
   "type": "stat",
   "title": "Santé globale",
   "datasource": {
    "type": "prometheus",
    "uid": "ffj2fwnh387pce"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "clamp_max(controller_agents_stuck, 1) + clamp_max(sum(increase(alarme_total[15m])) or vector(0), 1) + clamp_max(controller_drain_mode_active, 1) + clamp_max(sum(llm_provider_quota_exhausted), 1)",
     "legendFormat": "santé"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 2
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "✓ OK",
         "index": 0
        }
       }
      }
     ]
    }
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "description": "0 = tout va bien. Chaque point = un signal dégradé actif : agents bloqués, alarme récente (15 min), mode drainage, quota provider épuisé.",
