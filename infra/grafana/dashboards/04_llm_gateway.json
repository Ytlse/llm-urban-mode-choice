  {
   "type": "timeseries",
   "title": "Taux de réussite par provider (%/min)",
   "datasource": {
    "type": "prometheus",
    "uid": "ffj2fwnh387pce"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * rate(llm_provider_calls_ok_total[1m]) / clamp_min(rate(llm_provider_calls_ok_total[1m]) + rate(llm_provider_calls_err_total[1m]), 0.0001)",
     "legendFormat": "{{provider}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     },
     "color": {
      "mode": "palette-classic"
     },
     "unit": "percent"
    }
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "description": "Fenêtre glissante 1 min ; clamp_min évite les trous (NaN) hors trafic.",
   "id": 4,
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 12,
    "y": 1
   }
  },
  {
   "type": "bargauge",
   "title": "Taux de réussite par modèle (%)",
   "datasource": {
    "type": "prometheus",
    "uid": "ffj2fwnh387pce"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sort_desc((100 * llm_provider_calls_ok_total / clamp_min(llm_provider_calls_ok_total + llm_provider_calls_err_total, 1)) * on(provider) group_left(model) llm_provider_info)",
     "legendFormat": "{{provider}} · {{model}}",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 80
       },
       {
        "color": "green",
        "value": 95
       }
      ]
     },
     "unit": "percent",
     "max": 100,
     "min": 0
    }
   },
   "options": {
    "displayMode": "gradient",
    "orientation": "horizontal",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "description": "Fiabilité cumulée depuis le démarrage, du meilleur au pire (l'historique fin est dans le panel %/min).",
