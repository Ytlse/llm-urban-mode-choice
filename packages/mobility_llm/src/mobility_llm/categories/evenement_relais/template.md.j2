{% if m.modes_habituels %}  Usually gets around by: {{ m.modes_habituels | join(', ') }}
{% endif %}{% if m.trajets_du_jour %}  Today's schedule: {{ m.trajets_du_jour | join('; ') }}
{% endif %}{% endfor %}
{% endfor %}
