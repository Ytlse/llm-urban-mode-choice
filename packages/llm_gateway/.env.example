# Environment variables read by the LLM gateway (API, worker, CLI) and the controller.
# Copy to the repository root: `cp .env.example .env` (docker compose reads ./.env).
# Never commit a filled-in .env.

# ── Provider API keys (secrets) ──────────────────────────────────────────────
# Canonical name: PROVIDER_KEYS__<instance or adapter name in config/llm_gateway/providers.yaml>.
# An instance without a key is excluded from the rotation at startup.
PROVIDER_KEYS__openai=
PROVIDER_KEYS__mistral=
PROVIDER_KEYS__google=
# Second Google key (another Cloud project, hence another quota bucket).
PROVIDER_KEYS__google2=
PROVIDER_KEYS__groq=
PROVIDER_KEYS__cerebras=
# Local models served by LM Studio on the host (port 1234): any value enables the
# lmstudio_* instances; empty disables them.
PROVIDER_KEYS__lmstudio=
# Typed classifier decider ("Jev" arms of the paper).
PROVIDER_KEYS__typesafeAI=

# ── Provider file (deployment configuration, outside the package) ────────────
LLM_GATEWAY_PROVIDERS_FILE=config/llm_gateway/providers.yaml

# ── Redis and execution ──────────────────────────────────────────────────────
LLM_GATEWAY_REDIS__URL=redis://localhost:6379/0
LLM_GATEWAY_EXECUTOR__CELERY_BROKER_URL=redis://localhost:6379/1
LLM_GATEWAY_EXECUTOR__CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Optional layers ──────────────────────────────────────────────────────────
# YAML settings file (overrides the profile, overridden by the environment).
#LLM_GATEWAY_CONFIG=/etc/llm-gateway/config.yaml
# Shipped profile: free-tier (measured defaults) or paid.
#LLM_GATEWAY_PROFILE=free-tier

# ── Inference defaults (overridden per provider, then per request) ───────────
#LLM_GATEWAY_INFERENCE__TEMPERATURE=0.7
#LLM_GATEWAY_INFERENCE__MAX_TOKENS=4096

# ── Telemetry ────────────────────────────────────────────────────────────────
#LLM_GATEWAY_TELEMETRY__LOG_LEVEL=INFO
# Exchange log (full prompts and responses); default <workdir>/llm_exchanges.jsonl.
#LLM_GATEWAY_TELEMETRY__EXCHANGES_FILE=
